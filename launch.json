{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch RENSERI AI ASSISTANT (app.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "SL_OPEN_BROWSER": "1"
      },
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://[\\d.:]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Launch RENSERI AI ASSISTANT (run.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "SL_OPEN_BROWSER": "1"
      },
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://[\\d.:]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Pytest Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "console": "integratedTerminal"
    }
  ]
}
